{
  "name": "uch",
  "version": "0.3.0",
  "description": "Universal Cognitive Harness — persistent cognitive runtime any IDE, agent, or AI runtime can plug into",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "uch": "dist/cli/index.js"
  },
  "keywords": [
    "cognitive",
    "runtime",
    "specification",
    "memory",
    "agent",
    "substrate",
    "persistent-cognition",
    "knowledge",
    "harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "start:server": "node dist/cli/index.js serve",
    "start:mcp": "node dist/cli/index.js mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "uch": "node dist/cli/index.js",
    "ingest": "node dist/cli/index.js ingest",
    "check:spec-version": "node scripts/spec-version-check.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "glob": "^11.1.0",
    "openai": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
