# UCH — Universal Cognitive Harness
# Copy to .env and fill in your keys

# LLM Provider (at least one required for embeddings + AI features)
OPENAI_API_KEY=<your-openai-key>
# ANTHROPIC_API_KEY=<your-anthropic-key>
# GOOGLE_API_KEY=<your-google-key>

# Inference Fabric — extra compute resources for cognitive accelerators.
# Keys are compute resources, not identities; the fabric schedules and reroutes.
# CEREBRAS_API_KEY=<key>
# CEREBRAS_API_KEY_1=<key>
# CEREBRAS_API_KEY_2=<key>
# CEREBRAS_API_KEY_3=<key>
# CEREBRAS_MODEL=llama-3.3-70b

# Provider selection: openai | anthropic | google | auto (auto-detected from keys + model prefix)
# UCH_LLM_PROVIDER=auto
# Default model override (takes precedence over per-provider defaults)
# UCH_LLM_MODEL=

# Custom API endpoint (optional, for proxies or local models)
# OPENAI_BASE_URL=https://api.openai.com/v1
