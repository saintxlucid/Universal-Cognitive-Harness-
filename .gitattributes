# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Shell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Lock files
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff
