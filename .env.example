# ── Workspace Root Environment Variables ──────────────────────
# Copy to .env and fill in values
# Never commit .env files

# ── AI SDK Keys (optional) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
# Local inference gateway (LM Studio / one-api style) if keys are gateway-scoped
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# ── Docker Services ──
POSTGRES_USER=daira
POSTGRES_PASSWORD=daira_pwd
POSTGRES_DB=daira_db
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── MCP Servers (optional keys) ──
CONTEXT7_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
EXA_API_KEY=
EXA_API_KEY_1=
EXA_API_KEY_2=
SENTRY_AUTH_TOKEN=

# ── GitHub ──
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOKEN=
GH_TOKEN=

# ── OpenRouter ──
OPENROUTER_API_KEY=

# ── Google Stitch AI (stitch.withgoogle.com) ──
# Official SDK: @google/stitch-sdk. Key created in Stitch account (Google login)
STITCH_API_KEY=
STITCH_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
STITCH_HOST=https://stitch.googleapis.com/mcp

# ── DAIRA (projects/D A I R A) ──
DATABASE_URL=postgresql://daira:daira_pwd@localhost:5432/daira_db
SECRET_KEY=mysecretkey
NODE_ENV=development
API_PORT=4000
JWT_SECRET=your_jwt_secret
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=
MINIO_ROOT_USER=miniouser
MINIO_ROOT_PASSWORD=miniopass
MINIO_BUCKET=daira-media
KAFKA_BROKER=daira-redpanda:9092
VITE_API_URL=http://localhost:4000

# ── Cerebras Inference (free trial) ──
# Base URL: https://api.cerebras.ai/v1 (OpenAI-compatible, Bearer auth)
# Free models: gpt-oss-120b (production), gemma-4-31b (preview), zai-glm-4.7 (preview)
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_MODEL=gpt-oss-120b

# ── UCH — Universal Cognitive Harness ──
UCH_LLM_PROVIDER=auto
UCCP_HOST=localhost
UCCP_PORT=3100
UCCP_JWT_SECRET=
UCCP_MAX_TOKENS_PER_DAY=
UCCP_OTLP_ENDPOINT=
UCCP_TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── Project-specific env vars are in projects/<name>/.env.example ──
